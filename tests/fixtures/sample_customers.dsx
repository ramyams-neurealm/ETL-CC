BEGIN DSJOB
 Name "Job_Customers"
 Project "DemoProject"
 Description "Load customer data"
 BEGIN DSSTAGE
  Name "SRC_CUSTOMERS"
  Type "SequentialFile"
  BEGIN DSCOLUMN
   Name "CUSTOMER_ID"
   DataType "Integer"
   Nullable "NO"
  END DSCOLUMN
  BEGIN DSCOLUMN
   Name "CUSTOMER_NAME"
   DataType "VarChar"
   Length "100"
  END DSCOLUMN
 END DSSTAGE
 BEGIN DSSTAGE
  Name "TR_CUSTOMERS"
  Type "Transformer"
  BEGIN DSPORT
   Name "CUSTOMER_ID"
   DataType "Integer"
   PortType "OUTPUT"
   Derivation "CUSTOMER_ID"
  END DSPORT
 END DSSTAGE
 BEGIN DSSTAGE
  Name "TGT_CUSTOMERS"
  Type "Dataset"
  BEGIN DSCOLUMN
   Name "CUSTOMER_ID"
   DataType "Integer"
  END DSCOLUMN
  BEGIN DSCOLUMN
   Name "CUSTOMER_NAME"
   DataType "VarChar"
   Length "100"
  END DSCOLUMN
 END DSSTAGE
 BEGIN DSLINK
  FromStage "SRC_CUSTOMERS"
  ToStage "TR_CUSTOMERS"
  FromField "CUSTOMER_ID"
  ToField "CUSTOMER_ID"
 END DSLINK
 BEGIN DSPARAMETER
  Name "BatchDate"
  DataType "Date"
  DefaultValue "2026-01-01"
 END DSPARAMETER
 BEGIN DSSEQUENCE
  Name "Seq_Customers"
  BEGIN DSACTIVITY
   Name "Run_Job_Customers"
   JobName "Job_Customers"
  END DSACTIVITY
 END DSSEQUENCE
END DSJOB
